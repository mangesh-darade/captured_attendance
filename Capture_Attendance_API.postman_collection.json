              "description": "Optional 128-float face JSON descriptor for user auto-recognition",
              "type": "text"
            },
            {
              "key": "token",
              "value": "{{auth_token}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}attendance_api/derive_location_preview",
          "host": [
            "{{base_url}}attendance_api"
          ],
          "path": [
            "derive_location_preview"
          ]
        },
        "description": "Pre-resolves which warehouse/site geofence the device is currently inside and predicts whether the next punch should be check_in or check_out."
      },
      "response": []
    },
