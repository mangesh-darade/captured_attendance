{
  "info": {
    "_postman_id": "c1f7b830-4e3a-4a2b-98dc-a6d5c4b3e2f1",
    "name": "ElintOm - Capture Attendance Mobile & Kiosk API",
    "description": "Complete Postman collection for the Android Capture Attendance application and Kiosk terminals. Includes Setup, Authentication, Face Recognition Attendance Punch (Captured button), Geofencing, and Diagnostic logging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://192.168.0.239/ElintOm_PHP_8.5/",
      "type": "string",
      "description": "Server Base URL (Local LAN IP or Live Domain)"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "Mobile session JWT token (auto-populated upon login)"
    },
    {
      "key": "android_code",
      "value": "LH022",
      "type": "string",
      "description": "Merchant terminal unique pairing code"
    }
  ],
  "item": [
    {
      "name": "01 - Setup & Code Pairing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "android_code",
              "value": "{{android_code}}",
              "description": "Terminal unique activation code",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}attendance_api/setup",
          "host": [
            "{{base_url}}attendance_api"
          ],
          "path": [
            "setup"
          ]
        },
        "description": "Called on first app run to resolve the terminal's assigned merchant tenant store URL and store name using the unique Android Code."
      },
      "response": []
    },
    {
      "name": "02 - App Bootstrap & Init Data",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}attendance_api/init",
          "host": [
            "{{base_url}}attendance_api"
          ],
          "path": [
            "init"
          ]
        },
        "description": "Fetches tenant store branding, logo URLs, site name, server time, and predicted default attendance type (check_in / check_out)."
      },
      "response": []
    },
    {
      "name": "03 - Employee Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    try {",
              "        var res = pm.response.json();",
              "        if (res.token) {",
              "            pm.collectionVariables.set('auth_token', res.token);",
              "            console.log('Saved auth_token to collection variable: ' + res.token);",
              "        }",
              "    } catch (e) {",
              "        console.error('Failed to parse login token', e);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "phone",
              "value": "9876543210",
              "description": "Employee phone number or username",
              "type": "text"
            },
            {
              "key": "password",
              "value": "password123",
              "description": "Employee password",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}attendance_api/login",
          "host": [
            "{{base_url}}attendance_api"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Logs in the device user/employee. Returns a 30-day mobile authentication token used for subsequent punches and location checks."
      },
      "response": []
    },
    {
